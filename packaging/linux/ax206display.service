[Unit]
Description=AX206 USB display driver and web UI
Documentation=https://github.com/BeardedTech0o/ax206display
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ax206display
Group=ax206display
ExecStart=/opt/ax206display/ax206display
# config.json, secrets and the web password live here (STATE_DIRECTORY).
StateDirectory=ax206display
StateDirectoryMode=0700
Environment=ASPNETCORE_URLS=http://0.0.0.0:8206
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Local overrides (e.g. a different ASPNETCORE_URLS) without editing this file.
EnvironmentFile=-/etc/default/ax206display
Restart=on-failure
RestartSec=5

# Sandboxing. USB access comes from the udev rule's group, not root.
# Deliberately no ProtectClock=/DeviceAllow=: either one turns device access
# into an allowlist and cuts the service off from /dev/bus/usb.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
