<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Headless Linux host (Raspberry Pi and friends): drives the displays via
    Ax206Display.Engine and serves a web UI for managing layouts and
    integrations. Runs anywhere net10.0 does, but Linux + systemd is the
    target - see packaging/linux.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ax206display</AssemblyName>
    <RootNamespace>Ax206Display.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Listed so packages.lock.json covers every RID the release workflow
         publishes for; locked-mode restore otherwise fails on publish. -->
    <RuntimeIdentifiers>linux-arm64;linux-arm;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <!-- The content root is pinned to the binary's folder (see Program.cs), so
       the UI has to sit next to it in plain build output too, not only
       after a publish. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ax206Display.Engine\Ax206Display.Engine.csproj" />
  </ItemGroup>

</Project>
