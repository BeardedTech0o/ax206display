<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="LibUsbDotNet" Version="3.0.224" />
    <!-- Keep the Microsoft.Extensions.* packages on the same major as the
         target framework (net10.0): Hosting/.Http require Logging.Abstractions
         of at least their own version, and central package management refuses
         to silently downgrade below that floor. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- Pinned to the last version with a plain net8.0 target; 0.9.6+ moved to net8.0-windows7.0. -->
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.5" />

    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />

    <!-- Last 3.x line (4.148.0 moved to a later scheme). Must be >= 3.119.4 on
         Linux ARM: 3.118-3.119.2's ARM natives don't link libfontconfig and
         crash on first font use with "undefined symbol: uuid_generate_random"
         (mono/SkiaSharp#3272) - i.e. every Raspberry Pi. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- Pinned to the last version with a net8.0-windows target; 3.119.4 moved to net9.0-windows. -->
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.2" />

    <!-- Pinned to the last version with a net8.0-windows7.0 target; 2.4.x moved to net10.0-windows7.0. -->
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- sd_notify readiness + journald-friendly logging for the Linux server's systemd unit. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
